# Environment Configuration Template for Bible Central Backend
# Copy this file to .env and configure real values before running.

# Application Environment
APP_NAME="Bible Central Backend"
APP_ENV=development # Set to 'production' for Railway / live servers
DEBUG=false
API_V1_PREFIX="/api/v1"
SECRET_KEY=change_this_secret_key_in_production_min_32_chars!
ALLOWED_ORIGINS="https://your-frontend-domain.com,http://localhost:5173"

# Database Configuration (PostgreSQL 15+)
# In production (APP_ENV=production), PostgreSQL is MANDATORY. SQLite fallback is strictly prohibited.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bible_central_db

# Security & Startup Seed Flags
# In production, RUN_SEED_ON_STARTUP is completely ignored and automatic seeding is disabled.
RUN_SEED_ON_STARTUP=false

# Initial Super Administrator Setup
# Leave empty if you create admins manually or via CLI.
# In production, if provided, creates the initial super admin safely without exposing secrets in logs.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Security & Tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Multi-App
DEFAULT_APP_ID=verse_daily

# Google Play Developer API (Billing)
GOOGLE_PLAY_PACKAGE_NAME=com.aistudio.biblia.qxudqu
GOOGLE_PLAY_CREDENTIALS_JSON_PATH=
GOOGLE_PLAY_RTDN_TOPIC=

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=
FCM_SERVICE_ACCOUNT_PATH=

# AdMob & AdSense Configuration (Server-side IDs)
ADMOB_APP_ID_ANDROID=
ADSENSE_CLIENT_ID=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
