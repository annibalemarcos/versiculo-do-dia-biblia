# Environment Configuration Example for Bible Central Backend
# Copy to .env and fill in values for production

# Application
APP_NAME="Bible Central Backend"
APP_ENV=development
DEBUG=True
API_V1_PREFIX="/api/v1"
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars_long!
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000"

# Database (PostgreSQL)
# Format: postgresql+psycopg2://user:password@localhost:5432/bible_db
# For SQLite local fallback: sqlite:///./bible_dev.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bible_central_db

# Security & Tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Multi-App
DEFAULT_APP_ID=verse_daily

# Google Play Developer API (Billing)
GOOGLE_PLAY_PACKAGE_NAME=com.aistudio.biblia.qxudqu
GOOGLE_PLAY_CREDENTIALS_JSON_PATH=""
GOOGLE_PLAY_RTDN_TOPIC=""

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=""
FCM_SERVICE_ACCOUNT_PATH=""

# AdMob & AdSense Configuration (Server-side IDs)
ADMOB_APP_ID_ANDROID=""
ADSENSE_CLIENT_ID=""

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
