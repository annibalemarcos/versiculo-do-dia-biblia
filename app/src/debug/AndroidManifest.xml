<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      CRITICAL: Cleartext (HTTP) communication is ONLY permitted in DEBUG builds.
      This allows local development with FastAPI on Android Emulator (10.0.2.2)
      or physical Android phones on the same local Wi-Fi / LAN (192.168.x.x:8000).
      Release builds use src/main/AndroidManifest.xml which strictly enforces HTTPS.
    -->
    <application
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config_debug" />

</manifest>
